# Copie este arquivo para ".env" (sem o ".example") e preencha os valores
# reais. O ".env" NUNCA deve ir pro Git (já está no .gitignore).

# Console do Neon → seu projeto → "Connection string" (a com "?sslmode=require")
DATABASE_URL=postgresql://usuario:senha@ep-xxxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Uma frase aleatória, grande, só sua — usada pra assinar o login (JWT).
# Gere uma com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-uma-frase-aleatoria-bem-grande-e-dificil-de-adivinhar

# URLs que têm permissão de chamar esta API (separadas por vírgula).
# Coloque a URL do seu GitHub Pages aqui.
ALLOWED_ORIGINS=https://seu-usuario.github.io

# Usados só pelo "npm run seed" — cria o primeiro usuário (você), pra não
# precisar abrir a tela de cadastro sem ninguém logado ainda.
ADMIN_NOME=Seu Nome
ADMIN_EMAIL=voce@empresa.com
ADMIN_SENHA=escolha-uma-senha-forte-aqui

# A Render define isso sozinha em produção; só é usado se você rodar local.
PORT=3000
